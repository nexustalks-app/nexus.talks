# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WARNING: Never expose the service role key to the client
# Only use it in secure server-side operations if absolutely necessary
# SUPABASE_SERVICE_ROLE_KEY=

# Nexus Guide (server-only — never use NEXT_PUBLIC_ for any of these)
# Rollout: off | allowlist | all  (default: off)
GUIDE_ROLLOUT=
# Comma-separated user UUIDs, used when GUIDE_ROLLOUT=allowlist
GUIDE_ALLOWLIST=
# Bot account credentials — store only in Vercel Sensitive env vars, never commit
GUIDE_BOT_EMAIL=
GUIDE_BOT_PASSWORD=
# LLM provider adapter key (stub | <provider added in Stage 7>)
GUIDE_LLM_PROVIDER=
# Model identifier for the chosen provider
GUIDE_LLM_MODEL=
# Provider API key — store only in Vercel Sensitive env vars, never commit
GUIDE_LLM_API_KEY=
# Optional: override the provider base URL
GUIDE_LLM_BASE_URL=
# Optional: global daily reply cap (default 5000)
GUIDE_GLOBAL_DAILY_CAP=
